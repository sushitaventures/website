# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Client Application Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Local: mongodb://127.0.0.1:27017/luxury_real_estate or MongoDB Atlas URI)
# In development, leave blank to run API with unconfigured database mode.
MONGODB_URI=

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# --- Outgoing mail (Nodemailer / SMTP) for contact-form lead notifications ---
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, and an App Password as SMTP_PASS
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sushita Ventures <no-reply@example.com>"
# Lead recipients are managed in Admin → Leads & Enquiries (default: contact@sushitaventures.com)
