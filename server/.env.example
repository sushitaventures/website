# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Client Application Origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection String (Local: mongodb://127.0.0.1:27017/luxury_real_estate or MongoDB Atlas URI)
# In development, leave blank to run API with unconfigured database mode.
MONGODB_URI=

# Logging level (debug, info, warn, error)
LOG_LEVEL=info
